# Vorlage fuer den MCP-ZUGANG (mcp/, eigene Dokploy-App aus mcp/Dockerfile).
# Kopieren nach mcp/.env und ausfuellen. mcp/.env wird NIE committet.
#
# Der Importer (src/) hat seine eigene Vorlage: .env.example im Wurzelverzeichnis.
# Keine Variable dort wird hier gelesen und umgekehrt — DATABASE_URL, LINA_*,
# STATUS_WEBHOOK_URL usw. gehoeren NICHT in die Umgebung dieses Dienstes.
# Plan und Begruendung: docs/plan-skybridge.md, Einrichtung: mcp/README.md.
#
# Lokal braucht man die Datei nur, um den Server zu starten (`bun run dev`)
# oder den Katalog abzuziehen (`bun run katalog:abzug` — dafuer reicht
# MCP_DATABASE_URL). Die Tests laufen ohne sie; die Datenbanktests werden
# dann uebersprungen.
#
# In Dokploy NICHT zu setzen (das Dockerfile setzt sie selbst): __PORT (3000,
# Skybridge liest __PORT, nicht PORT), TZ, NODE_ENV, SKYBRIDGE_TELEMETRY_DISABLED,
# DO_NOT_TRACK. Lokal gibt es kein Dockerfile — die Telemetrie-Schalter stehen
# deshalb unten noch einmal.

# --- Datenbank: zwei Rollen, zwei Verbindungen -----------------------------

# Die LESEROLLE, nicht der Importer-Zugang. Sie sieht nur mart, manual,
# ampel und den Katalog in mcp, nur lesend, mit statement_timeout. Angelegt
# von Migration 0102; das Passwort setzt ein Mensch einmal von Hand:
#   ALTER ROLE mcp_leser LOGIN PASSWORD '...';
# In Dokploy die INTERNE Verbindung der Managed Database verwenden.
MCP_DATABASE_URL=postgresql://mcp_leser:hier-das-passwort@localhost/lina

# Die ANMELDEROLLE — eine zweite, getrennte Verbindung.
#
# Warum getrennt: mcp_leser fuehrt Nutzereingaben als SQL aus, und `mcp`
# steht auf der Liste der erlaubten Schemata. Laegen Passworthashes und
# Signierschluessel unter derselben Rolle, waere
#   SELECT privat_jwk FROM mcp.oauth_schluessel
# eine gueltige Abfrage — und wer sie stellt, stellt sich fortan selbst
# Tokens aus. mcp_anmeldung sieht nur die Anmeldetabellen und das
# Zugriffsprotokoll, mcp_leser sieht beides nicht (Migrationen 0104, 0148).
#   ALTER ROLE mcp_anmeldung LOGIN PASSWORD '...';
MCP_AUTH_DATABASE_URL=postgresql://mcp_anmeldung:hier-das-passwort@localhost/lina

# --- Oeffentliche Adresse --------------------------------------------------

# Die oeffentliche Adresse dieses Servers, MIT https:// und OHNE /mcp am Ende
# (sonst „oauth.baseUrl must be a valid absolute URL"). Sie ist zugleich
# Aussteller und Publikum der Tokens — ohne sie kann der Server weder
# ausstellen noch pruefen und startet nicht. Nach einem Domainwechsel in
# Dokploy mitziehen, sonst nennen die OAuth-Metadaten die alte Adresse.
# Produktion (seit 19.10.2026): https://concept-family.brainfood.space
# Lokal: http://localhost:3000
MCP_OEFFENTLICHE_URL=https://mcp.example.de

# --- Telemetrie aus (lokal) -----------------------------------------------

# Skybridges CLI (`bun run dev`, `bun run build`) meldet Nutzungsdaten an
# PostHog. Ein Dienst, der die Zahlen eines Unternehmens ausliefert, hat keinen
# Anlass, nebenbei nach draussen zu funken — und in einer Umgebung mit enger
# Egress-Regel scheitert der Build sonst daran. Im Container setzt das
# Dockerfile beide; lokal muessen sie hier stehen.
SKYBRIDGE_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# --- Nur fuer Tests --------------------------------------------------------

# Ein Test schreibt in den Katalog (test/katalog_nachladen.test.ts) und laeuft
# nur mit dieser Variable — und nur gegen einen LOKALEN Klon, sonst bricht er
# ab. Nie die Produktivdatenbank eintragen.
# MCP_TEST_SCHREIB_URL=postgresql://localhost/lina_mcp_klon
