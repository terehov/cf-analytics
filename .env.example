# Vorlage. Kopieren nach .env und ausfuellen. .env wird NIE committet.

# --- Postgres --------------------------------------------------------------
# Dokploy Managed Database: die INTERNE Verbindung verwenden, nicht die
# nach aussen veroeffentlichte. Postgres gehoert nicht ins Internet.
DATABASE_URL=postgres://user:pass@cf-postgres:5432/cf_analytics

# --- LINA-Zugang -----------------------------------------------------------
LINA_BASE_URL=https://app.lina.de
LINA_USER=

# ACHTUNG, das hat schon einmal drei Fehlanmeldungen gekostet (25.07.2026):
# Passwoerter mit Sonderzeichen MUESSEN in Anfuehrungszeichen stehen UND
# jedes '$' muss als \$ maskiert werden.
#
#   $  Bun expandiert '$name' zu einer Variablen - AUCH in einfachen
#      Anfuehrungszeichen. Quotieren allein reicht nicht.
#   #  beginnt einen Kommentar; alles dahinter faellt weg.
#
# Passiert still und ohne Warnung: LINA meldete daraufhin voellig zu Recht
# "Benutzername oder Passwort ist falsch!", und die Suche lief tagelang beim
# Hashverfahren statt bei der .env.
#
# Am Beispiel 'Ab$cdef1ghi&!jklm#nopqrs2' (25 Zeichen). Es braucht BEIDES -
# jede Haelfte allein reicht nicht:
#
#   FALSCH:   LINA_PASSWORD=Ab$cdef1ghi&!jklm#nopqrs2       ->  8 Zeichen
#   FALSCH:   LINA_PASSWORD='Ab$cdef1ghi&!jklm#nopqrs2'     -> 16 (Quotes allein: $ expandiert doch)
#   FALSCH:   LINA_PASSWORD=Ab\$cdef1ghi&!jklm#nopqrs2      -> 17 (Maskierung allein: # kommentiert doch)
#   RICHTIG:  LINA_PASSWORD='Ab\$cdef1ghi&!jklm#nopqrs2'    -> 25
#
# Zur Kontrolle, und zwar VOR jedem Anmeldeversuch: der Start loggt
# 'passwortLaenge'. Stimmt die Zahl nicht mit der tatsaechlichen
# Passwortlaenge ueberein, ist der Wert verstuemmelt - dann gar nicht erst
# anmelden, sondern die .env reparieren. Am 25.07.2026 hat genau diese Zeile
# eine kaputte Bearbeitung abgefangen, bevor ein Request rausging.
LINA_PASSWORD=''
# Mandant aus dem Login-Dropdown: a360 = LINA TeamCloud
LINA_SYSTEM=a360
# LINA hasht das Passwort clientseitig als MD5 (hex_md5 in /js/common/login.js).
# 'sha256' ist dort auskommentiert vorbereitet - falls LINA umstellt.
# 'plain' nur zum Debuggen.
LINA_PASSWORD_HASH=md5

# --- Browserkennung --------------------------------------------------------
# Vorbelegt mit aktuellem Chrome Stable auf Windows - die haeufigste
# Kombination und damit die unauffaelligste. Die Client-Hints (sec-ch-ua)
# ziehen die Versionsnummer automatisch nach.
# Nur anfassen, wenn Chrome eine neue Hauptversion hat; dann die Nummer
# anheben, nicht senken. Eine veraltete Version faellt mehr auf als gar keine.
# LINA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
# LINA_PLATTFORM=Windows

# --- FoodNotify ------------------------------------------------------------
# VIER MARKEN, VIER MANDANTEN, VIER KONTEN. Jeder Zugang sieht ausschliesslich
# die Betriebe seiner Marke - geprueft am 01.08.2026: das Aposto-Konto zeigt
# 14 Betriebe und laesst sich nicht auf eine andere Marke umschalten.
#
# Die Namen tragen den Markenschluessel aus core.marke, damit die Zuordnung
# ohne Uebersetzungstabelle lesbar ist.
#
# NICHT ALLE VIER MUESSEN GESETZT SEIN. Wer nur Aposto durchsticht, setzt nur
# Aposto; Marken ohne Zugangsdaten werden uebersprungen und das wird geloggt.
# Was NICHT geht, ist ein halbes Paar: Benutzer ohne Passwort (oder umgekehrt)
# ist ein Konfigurationsfehler und bricht den Start ab.
#
# ACHTUNG, DIESELBE FALLE WIE OBEN BEI LINA_PASSWORD: Sonderzeichen muessen in
# Anfuehrungszeichen, und jedes '$' als \$ maskiert. Sonst verstuemmelt Bun das
# Passwort still. Der Start loggt die Passwortlaenge je Marke - stimmt sie
# nicht, ist der Wert kaputt.
#
# UND: ein Fehlversuch wird nie wiederholt (AGENTS.md, Regel 7). Bei vier
# Konten heisst das zusaetzlich, dass ein falsches Passwort bei einer Marke
# die anderen drei nicht mitreissen darf.
FN_BASE_URL=https://my.foodnotify.com
# FN_APOSTO_USER=Admin.foodnotify@aposto.eu
# FN_APOSTO_PASSWORD='...'
# FN_ENCHILADA_USER=Admin.foodnotify@enchilada.de
# FN_ENCHILADA_PASSWORD='...'
# FN_DEUTSCHE_KONZEPTE_USER=Admin.foodnotify.deutsche@enchilada-gruppe.de
# FN_DEUTSCHE_KONZEPTE_PASSWORD='...'
# FN_WILMA_WUNDER_USER=support@wilma-wunder.de
# FN_WILMA_WUNDER_PASSWORD='...'

# --- Yext (Online-Bewertungen) ---------------------------------------------
# Die sechste Kennzahl des Round Table ist die einzige, die nicht aus unseren
# eigenen Systemen kommt. Sie kommt aus Yext - und Yext ist nicht von der
# Concept Family lizenziert, sondern von der Schwestergesellschaft Family &
# Friends Marketing, die im selben Konto auch fremde Kunden betreut
# (docs/yext-anbindung.md, Abschnitt 1).
#
# DARAUS FOLGT DAS WICHTIGSTE AN DIESEM ABSCHNITT: der Schluessel darf mehr
# sehen, als uns gehoert. Was uns gehoert, entscheidet deshalb NICHT die API,
# sondern manual.betrieb_fremd_id (system = 'yext') - dort stehen die
# Entitaets-IDs, die src/yext_zuordnen.ts einmal von Hand festgeschrieben hat.
# Alles, was die API darueber hinaus liefert, sind Standorte fremder Kunden
# und wird verworfen. Wer das umdreht und "alles, was der Schluessel sieht"
# importiert, holt sich fremde Geschaeftsdaten in die eigene Datenbank.
#
# Der Schluessel wird ausschliesslich serverseitig gehalten: hier in der .env,
# nie im Repository, nie im Browser. Und wie bei LINA und FoodNotify gilt die
# Bun-Falle - Werte mit Sonderzeichen in Anfuehrungszeichen, jedes '$' als \$.
#
# Pruefen, was der Schluessel wirklich sieht:  bun run src/yext_pruefen.ts
# YEXT_API_KEY=''
#
# Konto, auf das sich die Aufrufe beziehen. 'me' ist das Konto des Schluessels
# und der Normalfall. Eine echte accountId braucht es nur, falls wir als
# Unterkonto unter der Agentur haengen - das ist Frage 2 in
# docs/yext-anbindung.md und war am 03.08.2026 noch unbeantwortet.
# YEXT_ACCOUNT_ID=me
#
# Rechenzentrum. Deutsche Konten liegen haeufig in der EU-Instanz, und ein
# Schluessel der einen Instanz ist an der anderen schlicht ungueltig. Kommt
# ein 401 trotz frisch ausgestelltem Schluessel, ist das hier der erste
# Verdacht - nicht der Schluessel.
# YEXT_BASE_URL=https://api.yext.com        # EU: https://api.eu.yext.com
#
# Versionsdatum der Management API (Pflichtparameter `v`). Ein festes Datum in
# der Vergangenheit ist Absicht: Yext haelt alte Versionen stabil, und so
# aendert sich die Antwortform nicht unter uns weg, ohne dass jemand diese
# Zeile anfasst.
# YEXT_API_VERSION=20240401

# --- Bounti (Schulung und Audits) ------------------------------------------
# Das Schulungssystem der Concept Family. Es beantwortet EINEN Bericht aus
# examples/'Umsetzung Berichte (1).xlsx', Ebene "Laden": "E-Learning
# erfolgreiche Kurse". Dazu die Betriebsaudits mit Punktzahl.
#
# NICHT die "Fluktuationsraten" aus derselben Liste - die gehoert zu LINA
# (Team > Mitarbeiter > Stammdaten), und Bounti liest die Personaldaten
# selbst von dort. Begruendung in docs/entscheidungen.md, B4.
#
# NUR LESEN. Von den 29 Pfaden der Schnittstelle schreiben 22: sie legen
# Mitarbeitende an, archivieren und loeschen sie, weisen Kurse zu und
# verschicken Push-Nachrichten an alle Mitarbeitenden. src/bounti/client.ts
# kennt deshalb keine andere Methode als GET - das ist keine Konvention,
# sondern fehlender Code.
#
# DER SCHLUESSEL IST EIN BEARER-TOKEN, ohne Benutzer, ohne Passwort und ohne
# Ablauf. Bounti vergibt ihn ueber den Kundenservice. Ein 403
# INVALID_API_KEY ist deshalb immer ein Fall fuer einen Menschen und nie
# fuer eine Wiederholungsschleife.
#
# Es gilt die Bun-Falle wie ueberall sonst hier: Werte in Anfuehrungszeichen,
# jedes '$' als \$ maskieren. Sonst kuerzt Bun das Token still, und Bounti
# antwortet voellig zu Recht mit 403. Die Startzeile des Laufs meldet die
# TOKENLAENGE - stimmt sie nicht mit dem hinterlegten Wert ueberein, ist das
# die Ursache.
#
# Zugang pruefen, bevor der Nachtlauf ihn benutzt:  bun run bounti:pruefen
# BOUNTI_API_TOKEN=''
#
# Grundadresse. Aendert sich praktisch nie; steht hier, damit ein Test gegen
# eine Attrappe laufen kann, ohne den Code anzufassen.
# BOUNTI_BASE_URL=https://api.bounti.co
#
# Wie viele Zeilen eine Seite tragen soll. Die Spezifikation nennt 20 als
# Voreinstellung und 100 als Obergrenze - letzteres allerdings nur bei einem
# einzigen Endpunkt. Lehnt Bounti die grosse Seite mit HTTP 400 ab, faellt
# der Client fuer den Rest des Laufs dauerhaft auf 20 zurueck und sagt es
# einmal im Log.
# BOUNTI_SEITE=100
#
# Das Aufrufbudget EINES Laufs. Bountis Limit sind 3.000 Anfragen je Stunde,
# der Nachlauf laeuft hoechstens einmal am Tag - 1.200 lassen also reichlich
# Luft. Ist es aufgebraucht, hoert der Lauf geordnet auf; was fehlt, steht in
# mart.bounti_zuweisung_stand und wird in der naechsten Nacht geholt.
# BOUNTI_AUFRUFE_MAX=1200
#
# Wie viel Stundenkontingent uebrig bleiben soll. Bounti meldet den Rest in
# jeder Antwort (RateLimit-Remaining). Der Grund ist nicht Hoeflichkeit: wer
# das Kontingent leerraeumt, sperrt fuer den Rest der Stunde moeglicherweise
# auch die App der Mitarbeitenden aus, wenn sie am selben Schluessel haengt.
# BOUNTI_RESERVE=200
#
# Wie viele Kurse und Lernpfade eine Nacht hoechstens im Detail holt.
# Zuweisungen lassen sich NICHT inkrementell holen - der Endpunkt kennt
# keinen Zeitfilter -, deshalb eine Rotation mit Obergrenze statt eines
# Handbefehls. Die am laengsten nicht geholten zuerst.
# 120 ist am 24.08.2026 nachgemessen: der Katalog hat 470 Lerneinheiten,
# eine braucht im Schnitt drei Seiten. Vier Naechte fuer den ersten
# vollstaendigen Bestand, rund 360 Aufrufe je Nacht.
# BOUNTI_LERNEINHEITEN_JE_LAUF=120
#
# Abstand zwischen zwei Bounti-Nachlaeufen. 20 statt 24, damit der Lauf nicht
# taeglich eine Stunde spaeter rutscht und irgendwann ganz ausfaellt.
# BOUNTI_ABSTAND_STUNDEN=20

# --- Drosselung (LINA) -----------------------------------------------------
# Gilt NUR fuer LINA. FoodNotify hat eigene Werte, siehe weiter unten:
# zwei Anbieter, zwei Vertraege, zwei Risiken - eine Bremse gegenueber dem
# einen soll den anderen nicht ausbremsen.
#
# Pause zwischen zwei Aufrufen, zufaellig aus diesem Bereich.
# Nicht erhoehen, ohne dass ein Grund dafuer dokumentiert ist: das Tempo ist
# das, was die Integration am Leben haelt, keine Hoeflichkeit.
TAKT_MIN_MS=20000
TAKT_MAX_MS=40000
# Zweite Bremse: harte Obergrenze pro Kalendertag (UTC). Bewusst ueber dem,
# was der Takt zulaesst: 20-40 s ergeben im Mittel 30 s, also ~2880 Aufrufe
# in 24 h. So bremst der Takt, nicht das Budget - das Budget ist ein
# Notfallnetz gegen Fehler, die das Tempo aushebeln, keine Alltagsbremse.
TAGESBUDGET=3000

# --- Drosselung (FoodNotify) -----------------------------------------------
# OPTIONAL. Ohne diese Zeilen gelten die LINA-Werte oben - wer nichts setzt,
# bekommt das vorsichtigere Verhalten.
#
# Warum eigene Werte vertretbar sind: LINAs 20-40 s sind Tarnung. Es gibt
# genau einen Zugang, eine Sperre waere nicht rueckgaengig zu machen, und ein
# Client, der schneller klickt als ein Mensch, faellt in einem Report Center
# auf. FoodNotify ist ein bezahlter REST-Dienst mit dokumentierten Endpunkten
# und rund 58 ms Antwortzeit - dort ist ein zuegigerer Takt keine Wette,
# sondern bestimmungsgemaesse Nutzung.
#
# Das Budget zaehlt seit dem 02.08.2026 nur noch fn:-Aufrufe. Vorher lag es
# mit LINA in einem Topf: ein FoodNotify-Backfill mit 36.000 Posten haette
# LINAs Tagesdaten an einer Grenze scheitern lassen, die gar nicht fuer sie
# gilt.
#
# DAS BUDGET MUSS ZUM TAKT PASSEN. Bei 800-1500 ms sind rechnerisch ~75.000
# Aufrufe am Tag moeglich, gemessen 49.700. Steht das Budget darunter, endet
# der Tag VOR dem Takt: am 03.08.2026 bei 40.003 Aufrufen, und 1.778 Posten
# lagen bis zum naechsten Morgen. Wer den Takt aendert, muss diesen Wert
# nachziehen - sonst bremst still die falsche der beiden Grenzen.
#
# Fuer den einmaligen Backfill (~36.000 Posten) sinnvoll:
#FN_TAKT_MIN_MS=3000
#FN_TAKT_MAX_MS=6000
#FN_TAGESBUDGET=40000

# Arbeitsfenster in Ortszeit. 0 und 24 heisst: durchgehend, kein Fenster.
# Das ist seit dem 25.07.2026 die Voreinstellung - vorher 7 bis 23 Uhr.
# Begruendung: der Importer fragt ohnehin nur alle 20-40 Sekunden. Ein
# gleichmaessig langsamer Strom rund um die Uhr ist unauffaelliger als ein
# Geraet, das jeden Abend schlagartig verstummt und morgens wieder anspringt.
# Begrenzt wird ueber TAKT_* und TAGESBUDGET, nicht ueber die Uhrzeit.
# Ein Fenster laesst sich jederzeit wieder setzen (Untergrenze inklusive,
# Obergrenze exklusiv).
FENSTER_VON_STUNDE=0
FENSTER_BIS_STUNDE=24

# --- Fehlerverhalten -------------------------------------------------------
# Zeitlimit je Anfrage an LINA. OHNE DAS haengt ein Aufruf, der nie antwortet,
# den gesamten Worker auf - fetch wartet von sich aus unbegrenzt. Am 25.07.2026
# stand ein Lauf so ueber zehn Minuten still, waehrend der Posten davor 614 ms
# gebraucht hatte. Zusammen mit der Sperre gegen parallele Worker waere der
# Importer dauerhaft still gewesen, ohne dass es auffaellt.
ANFRAGE_TIMEOUT_MS=60000
MAX_VERSUCHE=4
ABBRUCH_NACH_FEHLERN=10
# Hoechstens so viele aufgegebene Posten holt EIN Lauf zurueck. Muss unter
# ABBRUCH_NACH_FEHLERN liegen: zehn wiederbelebte, deterministisch kaputte
# Posten liefen in den Laeufen 108-110 hintereinander ans Spurende und
# brachen den Lauf an seiner eigenen Wiederbelebung ab (01.09.2026).
WIEDERBELEBUNGEN_JE_LAUF=3
# 0 = unbegrenzt; der Worker laeuft, bis die Warteschlange leer oder das
# Tagesbudget aufgebraucht ist (ein Fensterende gibt es nicht mehr).
# Zum vorsichtigen Antesten: MAX_POSTEN_PRO_LAUF=1
MAX_POSTEN_PRO_LAUF=0

# --- Betrieb ---------------------------------------------------------------
# Container laeuft in UTC. Die Umrechnung auf den Berliner Geschaeftstag
# passiert explizit im Code (src/lib/time.ts) und in der Datenbank
# (core.geschaeftstag), nicht ueber die Umgebungszeitzone.
TZ=UTC
PORT=3000
LOG_LEVEL=info

# --- Metabase --------------------------------------------------------------
# Eigener Benutzer fuer den Importer, damit `uebernehmen.ts` sich selbst
# anmelden kann. Admin-Rechte, weil es Karten und Dashboards schreibt.
METABASE_URL=http://localhost:3000
METABASE_USER=importer@brain.food
METABASE_PASSWORD='hier-das-passwort'