node_modules/
.env
.env.*
!.env.example
*.log

# macOS
.DS_Store
**/.DS_Store

# Arbeitsdokumente einzelner Aufgaben - der bleibende Erkenntniswert steht in docs/
PROMPT-*.md

# Quelle der Anforderung, aber echte Geschaeftsdaten der Concept Family AG
# (Buchhaltung, Round-Table-Zahlen) plus ~31 MB Screenshots. Bewusst NICHT
# versioniert: das Repo soll spaeter auf GitHub deployt werden, und aus einer
# Git-Historie bekommt man so etwas nur schwer wieder heraus.
# Die Dateien bleiben lokal vorhanden.
examples/

# Playwright-MCP-Artefakte (Snapshots, Screenshots, Konsolenmitschnitte)
.playwright-mcp/

# Belege einer einzelnen Sichtpruefung im Wurzelverzeichnis: Screenshots von
# Metabase-Seiten und ausgekippte Accessibility-Snapshots. Sie zeigen, dass eine
# Karte an EINEM Tag richtig aussah - die Begruendung, warum sie so aussieht,
# steht in docs/. Dieselbe Ueberlegung wie bei examples/, nur kleiner.
*.jpeg
*.png
*-snapshot.yml
# Ausnahme (Eugene, 22.09.2026): das Screenshot-Archiv der LINA-Oberflaeche wird
# versioniert — es haelt fest, wie Berichte und Verwaltungsseiten zu einem Datum
# aussahen, fuer den Fall, dass LINA sie aendert oder der Zugang wegfaellt. Die
# Bilder zeigen echte Umsaetze und koennen Mitarbeiternamen zeigen; Zugangsdaten,
# Schluessel und IBANs sind ausgeschlossen (README im Ordner).
!docs/lina-screenshots/**/*.png

# Die heruntergeladenen Belegdateien: echte Rechnungen und Lieferscheine der
# Concept Family AG als PDF, dazu die daraus gezogenen E-Rechnungs-XML und ein
# Manifest mit Lieferant, Betrag und Kontierung. Beispieldaten fuer die
# PIM-Pipeline, erzeugt von `bun run belege-herunterladen` - dieselbe
# Ueberlegung wie bei examples/, nur dass es hier um Buchhaltungsbelege geht.
belege/

# Druckausgaben. Die Quelle ist die HTML-Datei daneben, das PDF nur ihr Abzug -
# knapp 1 MB je Stueck, weil die Schrift eingebettet wird, und bei jeder
# Neuerzeugung ein anderer Binaerklumpen. Wer es braucht, erzeugt es neu.
# Die Dateien bleiben lokal vorhanden.
*.pdf

# MCP-Server: Bauergebnisse
mcp/dist/
mcp/.skybridge/
