        "/api/1.0/recipes/categories": {
            "get": {
                "tags": [
                    "Category"
                ],
                "summary": "Get all Categories.",
                "operationId": "get_api_recipes_distinct_categories_index",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Current page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "orderBy",
                        "in": "query",
                        "description": "Order by field",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "orderId"
                        }
                    },
                    {
                        "name": "orderDirection",
                        "in": "query",
                        "description": "Order direction",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "ASC"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Get All Categories"
                    }
                }
            },
            "post": {
                "tags": [
                    "Category"
                ],
                "summary": "Create new Category.",
                "operationId": "post_api_recipes_distinct_categories_create",
                "requestBody": {
                    "description": "Payload to create a new Category",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "categoryName"
                                ],
                                "properties": {
                                    "categoryName": {
                                        "description": "The name of the category",
                                        "type": "string",
                                        "example": "My Category"
                                    },
                                    "orderId": {
                                        "description": "Order ID for sorting the category",
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "parent": {
                                        "description": "Parent category ID (if applicable)",
                                        "type": "integer",
                                        "example": 1345
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Details of the created Category"
                    }
                }
            }
        },
        "/api/1.0/recipes/categories/{id}": {
            "get": {
