                        "in": "path",
                        "description": "The ID of the category to update",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 123
                        }
                    }
                ],
                "requestBody": {
                    "description": "Payload to update the Category. All fields are optional.",
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "categoryName": {
                                        "description": "The updated name of the category",
                                        "type": "string",
                                        "example": "My Category"
                                    },
                                    "orderId": {
                                        "description": "The updated order ID for sorting the category",
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "parent": {
                                        "description": "The updated parent category ID (if applicable)",
                                        "type": "integer",
                                        "example": 1345
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
